# ==============================================================================
#  Custom configuration.  Sourced from the end of the stock ~/.bashrc; see
#  install.sh.  Machine-specific settings belong in ~/.bashrc.local.
# ==============================================================================

# Sourcing this file into a shell that still carries an older config's aliases
# fails outright: bash expands an alias before it parses `name() {`, so a
# leftover `alias dstop=...` turns the next function definition into a syntax
# error and aborts the rest of the file.  Clear the names defined as functions
# below before defining them.
unalias __auto_venv __banner __cmd_timer_begin __fmt_duration \
        __near_package_json __node_version __prompt_command \
        __prompt_palette docker_cleanup drm dstop extract fname ftext \
        git_log_enhanced gpum json_format mkcd mkproject path path_dedupe \
        path_prepend pip python up venv 2>/dev/null

# Repo root, derived from this file's own path without forking.
__src=${BASH_SOURCE[0]}
DOTFILES=${__src%/bash/bashrc}
unset __src

# ===== Helpers ================================================================

# Collapse repeated PATH entries, keeping the first of each so precedence is
# unchanged.  Duplicates arrive from the environment we inherit (~/.profile and
# /etc/profile.d both push the same directories), not from this file.
path_dedupe() {
    local out= entry
    local IFS=:
    for entry in $PATH; do
        [ -n "$entry" ] || continue
        case ":$out:" in
            *":$entry:"*) ;;
            *) out=${out:+$out:}$entry ;;
        esac
    done
    PATH=$out
}

# Prepend to PATH, but only if the directory exists and is not already there.
path_prepend() {
    [ -d "$1" ] || return 0
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$1:$PATH" ;;
    esac
}

