# ===== Prompt =================================================================
#
#   ╭─ user@host  ~/path  main *⇡2  py3.12  v22.23.2  1.4s  ✗1
#   ╰─❯
#
# Every segment is conditional: one with nothing to say prints nothing.

# Palette resolved once at startup: truecolor -> 256 -> 8 -> plain text.
__prompt_palette() {
    local ncolors=0
    if command -v tput >/dev/null 2>&1; then
        ncolors=$(tput colors 2>/dev/null) || ncolors=0
    fi
    case "$ncolors" in ''|*[!0-9]*) ncolors=0 ;; esac

    if [ "$ncolors" -ge 8 ]; then
        if [ "${COLORTERM:-}" = truecolor ] || [ "${COLORTERM:-}" = 24bit ]; then
            _c_user=$'\e[38;2;125;211;252m'
            _c_host=$'\e[38;2;103;232;249m'
            _c_path=$'\e[38;2;147;197;253m'
            _c_git=$'\e[38;2;250;204;21m'
            _c_env=$'\e[38;2;134;239;172m'
            _c_dim=$'\e[38;2;113;121;140m'
            _c_err=$'\e[38;2;248;113;113m'
            _c_ok=$'\e[38;2;134;239;172m'
        elif [ "$ncolors" -ge 256 ]; then
            _c_user=$'\e[38;5;117m'
            _c_host=$'\e[38;5;80m'
            _c_path=$'\e[38;5;111m'
            _c_git=$'\e[38;5;221m'
            _c_env=$'\e[38;5;114m'
            _c_dim=$'\e[38;5;242m'
            _c_err=$'\e[38;5;203m'
            _c_ok=$'\e[38;5;114m'
        else
            _c_user=$'\e[1;36m'
            _c_host=$'\e[0;36m'
            _c_path=$'\e[1;34m'
            _c_git=$'\e[1;33m'
            _c_env=$'\e[1;32m'
            _c_dim=$'\e[0;37m'
            _c_err=$'\e[1;31m'
            _c_ok=$'\e[1;32m'
        fi
        _c_off=$'\e[0m'
    else
        _c_user= _c_host= _c_path= _c_git= _c_env=
        _c_dim= _c_err= _c_ok= _c_off=
    fi
}
__prompt_palette

# Only set the window/tab title on terminals that understand OSC 0.
case "${TERM:-}" in
    xterm*|rxvt*|screen*|tmux*|vte*|alacritty*|foot*|konsole*|gnome*)
        _ps1_title='\[\e]0;\u@\h: \w\a\]' ;;
    *)  _ps1_title= ;;
esac

# Box glyphs need UTF-8; fall back to ASCII when the locale cannot promise it.
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *[Uu][Tt][Ff]*) _g_tl='╭─' _g_bl='╰─' _g_arrow='❯' _g_x='✗' ;;
    *)              _g_tl='.-' _g_bl='`-' _g_arrow='>'  _g_x='x' ;;
esac

# Git segment: reuse git's own prompt helper rather than parsing `git branch`.
# It understands dirty/staged/stash/untracked, ahead-behind, and the rebase,
# merge, bisect and detached-HEAD states.
if [ -r /usr/lib/git-core/git-sh-prompt ]; then
    . /usr/lib/git-core/git-sh-prompt
    GIT_PS1_SHOWDIRTYSTATE=1        # * unstaged, + staged
    GIT_PS1_SHOWSTASHSTATE=1        # $ something stashed
    GIT_PS1_SHOWUNTRACKEDFILES=1    # % untracked files present
    GIT_PS1_SHOWUPSTREAM=auto       # <, >, <> against upstream
    GIT_PS1_SHOWCONFLICTSTATE=yes
    # If this ever drags in a very large repo, disable the costly part there:
    #   git config bash.showUntrackedFiles false
fi

# Time the previous command.  The guard keeps the DEBUG trap from restarting
# the clock while the prompt itself is being built.
__cmd_start=
__in_prompt=
__cmd_timer_begin() {
    [ -n "$__in_prompt" ] && return
    [ -n "$__cmd_start" ] || __cmd_start=$SECONDS
}
trap '__cmd_timer_begin' DEBUG

__fmt_duration() {
    local s=$1
    if   [ "$s" -lt 60 ];   then printf '%ds' "$s"
    elif [ "$s" -lt 3600 ]; then printf '%dm%02ds' $((s / 60)) $((s % 60))
    else                         printf '%dh%02dm' $((s / 3600)) $(((s % 3600) / 60))
    fi
}

# `node -v` is a fork, so remember the answer per node binary.
__node_bin_cache=
__node_ver_cache=
__node_version() {
    local bin
    bin=$(command -v node 2>/dev/null) || return 0
    [ -n "$bin" ] || return 0
    if [ "$bin" != "$__node_bin_cache" ]; then
        __node_bin_cache=$bin
        __node_ver_cache=$("$bin" -v 2>/dev/null)
    fi
    printf '%s' "$__node_ver_cache"
}

# Walk up a few levels looking for package.json, without forking.
__near_package_json() {
    local dir=$PWD i=0
    while [ -n "$dir" ] && [ "$i" -lt 4 ]; do
        [ -f "$dir/package.json" ] && return 0
        dir=${dir%/*}
        i=$((i + 1))
    done
    return 1
}

__prompt_command() {
    local status=$?
    __in_prompt=1

    local elapsed=0
    [ -n "$__cmd_start" ] && elapsed=$((SECONDS - __cmd_start))
    __cmd_start=

    history -a          # share history between concurrent terminals
    __auto_venv

    local sep='  ' line1 line2

    # user@host -- the host is dim locally and loud over SSH, so a remote
    # session never looks like a local one.
    if [ -n "${SSH_CONNECTION:-}" ]; then
        line1="\[$_c_dim\]${_g_tl}\[$_c_off\] \[$_c_user\]\u\[$_c_off\]\[$_c_dim\]@\[$_c_off\]\[$_c_err\]\h\[$_c_off\]"
    else
        line1="\[$_c_dim\]${_g_tl}\[$_c_off\] \[$_c_user\]\u\[$_c_off\]\[$_c_dim\]@\h\[$_c_off\]"
    fi

    line1+="${sep}\[$_c_path\]\w\[$_c_off\]"

    # Left as a literal command substitution so bash evaluates it at render
    # time -- that also stops a hostile branch name from being re-expanded.
    if declare -F __git_ps1 >/dev/null 2>&1; then
        line1+="\[$_c_git\]\$(__git_ps1 '${sep}%s')\[$_c_off\]"
    fi

    # Active virtualenv.  `.venv` is named after its project, not itself.
    if [ -n "${VIRTUAL_ENV:-}" ]; then
        local vname=${VIRTUAL_ENV##*/}
        case "$vname" in
            .venv|venv|env)
                local parent=${VIRTUAL_ENV%/*}
                vname=${parent##*/}
                ;;
        esac
        vname=${vname//[^A-Za-z0-9._-]/}
        line1+="${sep}\[$_c_env\]${vname}\[$_c_off\]"
    fi

    if __near_package_json; then
        local nver
        nver=$(__node_version)
        [ -n "$nver" ] && line1+="${sep}\[$_c_env\]${nver}\[$_c_off\]"
    fi

    [ "$elapsed" -ge 2 ] && line1+="${sep}\[$_c_dim\]$(__fmt_duration "$elapsed")\[$_c_off\]"

    line2="\[$_c_dim\]${_g_bl}\[$_c_off\]"
    if [ "$status" -eq 0 ]; then
        line2+="\[$_c_ok\]${_g_arrow}\[$_c_off\] "
    else
        line1+="${sep}\[$_c_err\]${_g_x}${status}\[$_c_off\]"
        line2+="\[$_c_err\]${_g_arrow}\[$_c_off\] "
    fi

    # _ps1_title restores the xterm/tab title that the old prompt dropped.
    PS1="${_ps1_title}${line1}\n${line2}"

    __in_prompt=
}

PROMPT_COMMAND='__prompt_command'
PROMPT_DIRTRIM=3
PS2="\[$_c_dim\] ...\[$_c_off\] "

