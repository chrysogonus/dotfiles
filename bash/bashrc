# Stop every running container.
dstop() {
    local ids
    ids=$(docker ps -q)
    if [ -z "$ids" ]; then
        echo "no running containers"
        return 0
    fi
    docker stop $ids
}

# Remove stopped containers only -- never touches something still running.
drm() {
    local ids
    ids=$(docker ps -aq --filter status=exited --filter status=created)
    if [ -z "$ids" ]; then
        echo "no stopped containers"
        return 0
    fi
    docker rm $ids
}

docker_cleanup() {
    docker container prune -f
    docker image prune -f
}
alias dclean='docker_cleanup'

# GPU / ML.  Under WSL, nvidia-smi comes from the Windows NVIDIA driver.  It may
# exist even when GPU integration is unavailable, so gpum reports that case
# cleanly instead of treating system RAM as GPU memory.
alias gpu='watch -n1 nvidia-smi'
alias gput='nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw,clocks.sm --format=csv'

gpum() {
    local summary processes
    if ! command -v nvidia-smi >/dev/null 2>&1; then
        echo 'gpum: nvidia-smi is not installed' >&2
        return 127
    fi
    if ! summary=$(nvidia-smi \
        --query-gpu=index,name,memory.used,memory.total \
        --format=csv,noheader 2>&1); then
        printf 'gpum: NVIDIA GPU stats are unavailable in this WSL session\n%s\n' \
            "$summary" >&2
        return 1
    fi
    printf 'GPU memory:\n'
    while IFS= read -r line; do
        printf '  %s\n' "$line"
    done <<< "$summary"

    printf 'compute processes:\n'
    processes=$(nvidia-smi --query-compute-apps=pid,process_name,used_memory \
                           --format=csv,noheader 2>/dev/null) || processes=
    if [ -n "$processes" ]; then
        while IFS= read -r line; do
            printf '  %s\n' "$line"
        done <<< "$processes"
    else
        echo '  (none)'
    fi
}

