# ===== Startup banner =========================================================

__banner() {
    local kern arch mem_total mem_avail
    read -r kern < /proc/sys/kernel/osrelease
    arch=${MACHTYPE%%-*}

    while read -r k v _; do
        case $k in
            MemTotal:)     mem_total=$v ;;
            MemAvailable:) mem_avail=$v ;;
        esac
    done < /proc/meminfo

    printf '\n  %s%s%s %s%s · %s%s\n' \
        "$_c_user" "${HOSTNAME}" "$_c_off" "$_c_dim" "$kern" "$arch" "$_c_off"

    if command -v nvidia-smi >/dev/null 2>&1; then
        local gpu_stats name util gpu_used gpu_total temp power
        if gpu_stats=$(nvidia-smi \
                --query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw \
                --format=csv,noheader,nounits 2>/dev/null); then
            IFS=, read -r name util gpu_used gpu_total temp power <<< "$gpu_stats"
            printf '  %s%s%s%s %s%% · %s/%s MiB · %s°C · %sW%s\n' \
                "$_c_env" "${name# }" "$_c_off" "$_c_dim" "${util# }" \
                "${gpu_used# }" "${gpu_total# }" "${temp# }" "${power# }" "$_c_off"
        fi
    fi

    printf '  %smemory%s %d/%d GiB   %sdisk%s %s free on /\n' \
        "$_c_dim" "$_c_off" $(((mem_total - mem_avail) / 1048576)) $((mem_total / 1048576)) \
        "$_c_dim" "$_c_off" "$(df -h --output=avail / | tail -1 | tr -d ' ')"

    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local branch changed
        branch=$(git branch --show-current 2>/dev/null)
        changed=$(git status --porcelain 2>/dev/null | wc -l)
        printf '  %srepo%s %s on %s%s%s · %s change(s)\n' \
            "$_c_dim" "$_c_off" "${PWD##*/}" \
            "$_c_git" "${branch:-detached}" "$_c_off" "$changed"
    fi
    printf '\n'
}

# Top-level interactive shells only: never inside scripts, subshells, or a
# terminal that cannot render it.  SSH sessions DO get the banner -- this box
# is normally reached over Remote-SSH, so skipping them would hide it always.
# Set BASHRC_NO_BANNER=1 to turn it off.
# SHLVL is unreliable here (bash increments it before this file runs), so use
# an exported marker instead: it is unset in a fresh terminal and inherited by
# every nested shell, which is exactly the distinction we want.
if [[ $- == *i* ]] && [ -z "${__BANNER_SHOWN:-}" ] &&
   [ -z "${BASHRC_NO_BANNER:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
    export __BANNER_SHOWN=1
    __banner
fi

# Jump into workspace
[ "$PWD" = "$HOME" ] && [ -d ~/workspace ] && cd ~/workspace

# Per-machine settings (paths, work-only aliases, anything private).  Never
# committed.
[ -r "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"
