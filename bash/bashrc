# ===== Functions ==============================================================

# Create (if needed) and activate a virtualenv.
venv() {
    local dir=${1:-.venv}
    if [ ! -f "$dir/bin/activate" ]; then
        python -m venv "$dir" || return 1
    fi
    . "$dir/bin/activate"
}

# `python` as a function, not an alias: an alias would win over PATH and
# shadow the interpreter of whatever virtualenv is active.
python() {
    if [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
        "$VIRTUAL_ENV/bin/python" "$@"
    elif command -v python3.12 >/dev/null 2>&1; then
        python3.12 "$@"
    else
        python3 "$@"
    fi
}

pip() {
    if [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/pip" ]; then
        "$VIRTUAL_ENV/bin/pip" "$@"
    else
        python -m pip "$@"
    fi
}

# Activate the nearest .venv on entry, deactivate it on leaving.  Only ever
# touches a venv it activated itself, so a manual `source .../activate` stands.
__AUTO_VENV=
__auto_venv() {
    local dir=$PWD target=
    while [ -n "$dir" ]; do
        if [ -f "$dir/.venv/bin/activate" ]; then
            target="$dir/.venv"
            break
        fi
        dir=${dir%/*}
    done

    if [ -n "$target" ]; then
        [ "${VIRTUAL_ENV:-}" = "$target" ] && return 0
        # Someone activated a venv by hand -- leave it alone.
        [ -n "${VIRTUAL_ENV:-}" ] && [ -z "$__AUTO_VENV" ] && return 0
        if [ -n "$__AUTO_VENV" ]; then
            deactivate >/dev/null 2>&1
            __AUTO_VENV=
        fi
        if . "$target/bin/activate" >/dev/null 2>&1; then
            __AUTO_VENV=$target
        fi
    elif [ -n "$__AUTO_VENV" ]; then
        deactivate >/dev/null 2>&1
        __AUTO_VENV=
    fi
}

# Search file contents (ripgrep when available, grep otherwise).
ftext() {
    if command -v rg >/dev/null 2>&1; then
        rg -i -n -w --color=auto -- "$1" .
    else
        grep -iRnw --color=auto -- "$1" .
    fi
}

# Find files by name fragment.
fname() {
    find . -iname "*$1*"
}

mkcd() {
    mkdir -p -- "$1" && cd -- "$1" || return
}

# Go up N directories (default 1).
up() {
    local n=${1:-1} path=
    while [ "$n" -gt 0 ]; do
        path="../$path"
        n=$((n - 1))
    done
    cd "${path:-.}" || return
}

# PATH, one entry per line.
path() {
    printf '%s\n' "${PATH//:/$'\n'}"
}

extract() {
    if [ ! -f "$1" ]; then
        echo "extract: '$1' is not a file" >&2
        return 1
    fi
    case "$1" in
        *.tar.bz2|*.tbz2) tar xjf   "$1" ;;
        *.tar.gz|*.tgz)   tar xzf   "$1" ;;
        *.tar.xz|*.txz)   tar xJf   "$1" ;;
        *.tar.zst)        tar --zstd -xf "$1" ;;
        *.tar)            tar xf    "$1" ;;
        *.bz2)            bunzip2   "$1" ;;
        *.gz)             gunzip    "$1" ;;
        *.xz)             unxz      "$1" ;;
        *.zip)            unzip     "$1" ;;
        *.7z)             7z x      "$1" ;;
        *.rar)            unrar x   "$1" ;;
        *.Z)              uncompress "$1" ;;
        *) echo "extract: don't know how to extract '$1'" >&2; return 1 ;;
    esac
}

# Scaffold a new project.
mkproject() {
    mkdir -p "$1" || return 1
    cd "$1" || return 1
    git init -q
    touch README.md .gitignore
    mkdir -p src tests
    echo "Project $1 created!"
}

json_format() {
    if [ -p /dev/stdin ]; then
        python -m json.tool
    else
        python -m json.tool "$1"
    fi
}
alias jf='json_format'

